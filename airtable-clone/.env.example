# Copy to .env; local env files are gitignored. Never commit real credentials.
# This app uses Google OAuth, not Discord.
# Generate a local secret: openssl rand -base64 32
NEXTAUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Local origin; do not copy a deployed AUTH_URL/NEXTAUTH_URL here.
AUTH_URL="http://localhost:3000"

# Use a dedicated development database.
DATABASE_URL="postgresql://postgres:password@localhost:5432/airtable-clone"
